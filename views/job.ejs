<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <!-- <script defer>
        let table = new DataTable('#job-table');
    </script> -->
</head>
<body>
    <table id="job-table">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company Name</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Position Type</th>
                <th>Date Posted</th>
                <th>Post Expiration</th>
                <th>Apply Now</th>
            </tr>
        </thead>
        <tbody>
            <% postings.forEach(post => { %> 
                <tr>
                    <td><%= post.jobTitle %></td>
                    <td><%= post.companyName %></td>
                    <td><%= post.tradeArea %></td>
                    <td><%= post.jobLocation %></td>
                    <td><%= post.jobType %></td>
                    <td><%= post.jobStartDate %></td>
                    <td><%= post.jobEndDate %></td>
                    <td><%= post.jobUrl %></td>
                </tr>

            <% }); %>
        </tbody>
    </table>
    <script>
        new DataTable('#order-table');
    </script>
</body>
</html>