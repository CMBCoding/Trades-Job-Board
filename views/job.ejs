<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<body>
    <table id="job-table" class="display">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company Name</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Position Type</th>
                <th>Date Posted</th>
                <th>Post Expiration</th>
                <th>Apply Now</th>
            </tr>
        </thead>
        <tbody>
            <% postings.forEach(post => { %> 
                <tr>
                    <td><%= post.jobTitle %></td>
                    <td><%= post.companyName %></td>
                    <td><%= post.tradeArea %></td>
                    <td><%= post.jobLocation %></td>
                    <td><%= post.jobType %></td>
                    <td><%= post.jobStartDate %></td>
                    <td><%= post.jobEndDate %></td>
                    <td><%= post.jobUrl %></td>
                </tr>

            <% }); %>
        </tbody>
    </table>
    <script>
        new DataTable('#job-table', {
            responsive: true
        });
    </script>
</body>
</html>