<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<body>
    <header>

    </header>
    <main id="main-content">
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Company Name</th>
                    <th>Trade Area</th>
                    <th>Location</th>
                    <th>Position Type</th>
                    <th>Date Posted</th>
                    <th>Post Expiration</th>
                    <th data-orderable="false">Apply Now</th>
                </tr>
            </thead>
            <tbody>
                <% postings.forEach(post => { %> 
                    <tr>
                        <td><%= post.jobTitle %></td>
                        <td><%= post.companyName %></td>
                        <td><%= post.tradeArea %></td>
                        <td><%= post.jobLocation %></td>
                        <td><%= post.jobType %></td>
                        <td><%= post.jobStartDate %></td>
                        <td><%= post.jobEndDate %></td>
                        <td><button id="apply" onclick="window.open('<%= post.jobUrl %>', '_blank')">Apply Now</button></td>
                    </tr>

                <% }); %>
            </tbody>
        </table>
    </main>
    <script>
        new DataTable('#job-table', {
            responsive: true
        });
    </script>
</body>

</html>