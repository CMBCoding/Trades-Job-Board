<!DOCTYPE html>
<html lang="en">
<head>
<%-include('partials/head.ejs') %>
</head>
<body>
    <main>
        <h1 class="wallpoet">Post Successful!</h1>
        <h2>Job posting summary </h2>
        <p>Job Title: <%= post.jobTitle %></p>
        <p>Company: <%= post.companyName %></p>
        <p>Trade area: <%= post.tradeArea %></p>
        <p>Job location: <%= post.jobLocation %></p>
        <p>Job Type: <%= post.jobType %></p>
        <p>Start date: <%= post.jobStartDate %></p>
        <p>End date: <%= post.jobEndDate %></p>
        <p>URL: <%= post.jobUrl %></p>
        <p>Date and Time: <%= post.timestamp.toLocaleString() %></p>
    </main>
</body>
</html>