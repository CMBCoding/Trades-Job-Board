<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>post confirmation</title>
</head>
<body>
    <main>
        <h1>Post Successful!</h1>
        <h2>Job posting summary </h2>
        <p>Job Title: <%= post.job-title %></p>
        <p>Company: <%= post.company-name %></p>
        <p>Trade area: <%= post.trade-area %></p>
        <p>Job location: <%= post.job-location %></p>
        <p>Job Type: <%= post.job-type %></p>
        <p>Start date: <%= post.job-start-date %></p>
        <p>End date: <%= post.job-end-date %></p>
        <p>URL: <%= post.job-url %></p>
        <p>Date and Time: <%= post.timestamp.toLocaleString() %></p>
    </main>
</body>
</html>