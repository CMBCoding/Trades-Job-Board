<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<title>Add Jobs - Confirmation - Green River College</title>
<body>
    <%-include('partials/header.ejs') %>
    <main id="main">
        <div class="box">
            <h1 class="wallpoet" id="page-heading">Post Successful!</h1>
            <h2>Job posting summary </h2>
            <p><strong>Job Title:</strong> <%= post.jobTitle %></p>
            <p><strong>Company:</strong> <%= post.companyName %></p>
            <p><strong>Trade area:</strong> <%= post.tradeArea %></p>
            <p><strong>Job location:</strong> <%= post.jobLocation %></p>
            <p><strong>Job Type:</strong> <%= post.positionType %></p>
            <p><strong>Job Status:</strong> <%= post.positionStatus %></p>
            <p><strong>Start date:</strong> <%= post.jobStartDate %></p>
            <p><strong>End date:</strong> <%= post.jobEndDate %></p>
            <p><strong>URL:</strong> <%= post.jobUrl %></p>
            <p><strong>Date and Time:</strong> <%= post.timestamp.toLocaleString() %></p>

            <a href="/">
                <button type="submit" id="jobs-button">To Jobs Page</button>
            </a>
        </div>
    </main>
    <%-include('partials/footer.ejs') %>
</body>
</html>