<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<title>Trades Internships & Jobs Board - Green River College</title>
<body id="job-body">
<%-include('partials/header.ejs') %>

    <main id="main-content">
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Post Date</th>
                    <th>Company Name</th>
                    <th>Trade Area</th>
                    <th>Location</th>
                    <th>Position Type</th>
                    <th>Position Status</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th data-orderable="false">Apply Now</th>    
                </tr>
            </thead>
            <tbody>
                <% postings.forEach(post => { %> 
                    <tr>
                        <td><%= post.JobTitle %></td>
                        <td><%= post.PostDate.toLocaleString()%></td>
                        <td><%= post.CompanyName %></td>
                        <td><%= post.TradeArea %></td>
                        <td><%= post.Location %></td>
                        <td><%= post.PositionType %></td>
                        <td><%= post.PositionStatus %></td>
                        <td><%= post.StartDate.toLocaleString() %></td>
                        <td><%= post.EndDate.toLocaleString() %></td>
                         <td><a href="<%= post.JobUrl %>" target="_blank" class="btn-link">Apply</a></td>
                        
                    </tr>

                <% }); %>
            </tbody>
        </table>
    </main>
    <script>
        new DataTable('#job-table', {
            responsive: true,
            columns: [
                {name: 'job_title'},
                {name: 'post_date'},
                {name: 'company_name'},
                {name: 'trade_area'},
                {name: 'job_location'},
                {name: 'position_type'},
                {name: 'position_status'},
                {name: 'start_date'},
                {name: 'end_date'},
                {name: 'apply'}
                
            ],
            order: {
                name: 'post_date',
                dir: 'desc'
            }
        });
    </script>
</body>
<%-include('partials/footer.ejs') %>
</html>