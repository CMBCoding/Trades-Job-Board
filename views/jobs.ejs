<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<body id="job-body">
<%-include('partials/header.ejs') %>

    <main id="main-content">
        <div id="jobs-intro">
            <p>Welcome the Green River College Trade's Program Job's Board!</p>
            <p>Below is a full list of positions. You can also user the filter to sort postings by trade area.</p>
            <p>Happy Hunting, Gators!</p>
        </div>
        <!-- Data Table containing job/intern information. -->
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <!-- Apply now is no longer sortable by clicking the table header of it. -->
                    <th data-orderable="false">Apply Now</th>    
                    <th>Job Title</th>
                    <th>Trade Area</th>
                    <th>Company Name</th>
                    <th>Location</th>
                    <th>Position Type</th>
                    <th>Position Status</th>
                    <th>Apply By</th>
                </tr>
            </thead>
            <tbody>
                <% postings.forEach(post => { %> 
                    <tr>
                        <td><a href="<%= post.JobUrl %>" target="_blank" class="btn-link">Apply</a></td>
                        <td><%= post.JobTitle %></td>
                        <td><%= post.TradeArea %></td>
                        <td><%= post.CompanyName %></td>
                        <td><%= post.Location %></td>
                        <td><%= post.PositionType %></td>
                        <td><%= post.PositionStatus %></td>
                        <td><%= post.EndDate.toLocaleDateString() %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>
<%-include('partials/footer.ejs') %>
</body>

</html>