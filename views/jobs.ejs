<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<body id="job-body">
<%-include('partials/header.ejs') %>

    <main id="main-content">
        <!-- Data Table containing job/intern information. -->
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <!-- Apply now is no longer sortable by clicking the table header of it. -->
                    <th data-orderable="false">Apply Now</th>    
                    <th>Job Title</th>
                    <th>Trade Area</th>
                    <th>Company Name</th>
                    <th>Location</th>
                    <th>Position Type</th>
                    <th>Position Status</th>
                    <th>Apply By</th>
                </tr>
            </thead>
            <tbody>
                <% postings.forEach(post => { %> 
                    <tr>
                        <td><a href="<%= post.JobUrl %>" target="_blank" class="btn-link">Apply</a></td>
                        <td><%= post.JobTitle %></td>
                        <td><%= post.TradeArea %></td>
                        <td><%= post.CompanyName %></td>
                        <td><%= post.Location %></td>
                        <td><%= post.PositionType %></td>
                        <td><%= post.PositionStatus %></td>
                        <td><%= post.EndDate.toLocaleDateString() %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>
    <!-- Script to create a new instance of a Data table. -->
    <script>
        new DataTable('#job-table', {
            responsive: true,
            columns: [
                {name: 'apply'},
                {name: 'job_title'},
                {name: 'trade_area'},
                {name: 'company_name'},
                {name: 'job_location'},
                {name: 'position_type'},
                {name: 'position_status'},
                {name: 'end_date'}
            ],
            order: {
                name: 'post_date',
                dir: 'asc'
            },

            columnDefs: [
		        {
			        searchBuilder: {
				        defaultCondition: '=',
                        defaultData: 'trade_area'
			        },
			    targets: [1]
		        },
            ],
            layout: {
                topStart: 'searchBuilder'
            }
        });
    </script>
</body>
<%-include('partials/footer.ejs') %>
</html>