<!DOCTYPE html>
<html lang="en">
<%-include('partials/head.ejs') %>
<title>Trades Internships & Jobs Board - Green River College</title>
<body id="job-body">
<%-include('partials/header.ejs') %>

    <main id="main-content">
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Company Name</th>
                    <th>Trade Area</th>
                    <th>Location</th>
                    <th>Position Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th data-orderable="false">Apply Now</th>
                    <th>Post Date</th>
                </tr>
            </thead>
            <tbody>
                <% postings.forEach(post => { %> 
                    <tr>
                        <td><%= post.jobTitle %></td>
                        <td><%= post.companyName %></td>
                        <td><%= post.tradeArea %></td>
                        <td><%= post.jobLocation %></td>
                        <td><%= post.jobType %></td>
                        <td><%= post.jobStartDate %></td>
                        <td><%= post.jobEndDate %></td>
                        <td><button id="apply" onclick="window.open('<%= post.jobUrl %>', '_blank')">Apply Now</button></td>
                        <td><%= post.timestamp.toLocaleString() %></td>
                    </tr>

                <% }); %>
            </tbody>
        </table>
    </main>
    <script>
        new DataTable('#job-table', {
            responsive: true,
            columns: [
                {name: 'job_title'},
                {name: 'company_name'},
                {name: 'trade_area'},
                {name: 'job_location'},
                {name: 'job_type'},
                {name: 'start_date'},
                {name: 'end_date'},
                {name: 'apply'},
                {name: 'post_date'}
            ],
            order: {
                name: 'start_date',
                dir: 'asc'
            }
        });
    </script>
</body>
<%-include('partials/footer.ejs') %>
</html>